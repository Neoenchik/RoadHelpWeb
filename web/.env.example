# ───────────── App ─────────────
NODE_ENV=development
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
NEXT_PUBLIC_YANDEX_MAPS_API_KEY=

# ───────────── Backend ─────────────
DATABASE_URL=postgresql+asyncpg://road:road@postgres:5432/roadhelp
REDIS_URL=redis://redis:6379/0
SECRET_KEY=change-me-to-a-random-32-byte-string
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=30
ALLOWED_ORIGINS=http://localhost:3000

# ───────────── SMS ─────────────
# mock — выводит OTP в stdout, sms_ru — реальный провайдер
SMS_PROVIDER=mock
SMS_RU_API_ID=

# ───────────── S3 / MinIO ─────────────
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_BUCKET=roadhelp
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1

# ───────────── Web Push (VAPID) ─────────────
# Сгенерировать: npx web-push generate-vapid-keys --json
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@roadhelp.local
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# ───────────── Бизнес-параметры ─────────────
MATCHING_RADIUS_KM=50
EXECUTOR_ACCEPT_TIMEOUT_SEC=60
ARRIVAL_RADIUS_M=200
CANCEL_RATE_THRESHOLD=0.20

# ───────────── Email (для admin/operator invites) ─────────────
# В dev ссылки выводятся в stdout
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@roadhelp.local
INVITE_BASE_URL=http://localhost:3000

# ───────────── Bootstrap первого админа ─────────────
ADMIN_BOOTSTRAP_EMAIL=admin@roadhelp.local
