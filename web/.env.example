# Copy to .env and fill in values before running docker compose

# PostgreSQL (used by docker-compose defaults)
POSTGRES_DB=roadhelp
POSTGRES_USER=road
POSTGRES_PASSWORD=road

# JWT (required for API)
JWT__Secret=change_me_to_a_long_random_string_in_production
JWT__Issuer=RoadHelp
JWT__Audience=RoadHelpFront

# Telegram bot — get from @BotFather
BOT_TOKEN=
BOT_SECRET=change_me_bot_secret
ADMIN_IDS=

# Frontend URLs
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_WS_URL=http://localhost:8080
APP__BaseUrl=http://localhost:3000

# Dev OTP code (remove in production when SMS is wired)
OTP_DEV_CODE=1234

# Yandex Maps (optional — map placeholder shown without key)
NEXT_PUBLIC_YANDEX_MAPS_API_KEY=

# Web Push (optional)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
